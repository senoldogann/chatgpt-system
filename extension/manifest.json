{
  "manifest_version": 3,
  "name": "chatgpt-system companion",
  "version": "0.4.0",
  "description": "Yerel chatgpt-system durumunu ChatGPT sayfasında gösterir: proje bağlamı, daraltma brifi ve terminal akışı. Komut çalıştırmaz, dosyaya dokunmaz.",
  "minimum_chrome_version": "125",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt-dom.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "chatgpt-system"
  }
}
