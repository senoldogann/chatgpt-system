{
  "name": "chatgpt-system",
  "version": "0.1.0",
  "description": "Secure local MCP bridge for controlled filesystem, Git, process, and browser automation access.",
  "type": "module",
  "private": true,
  "bin": {
    "chatgpt-system": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:broker:macos": "swift build -c release --package-path native/macos-authority-broker",
    "build:computer:macos": "swift build -c release --package-path native/macos-computer-runtime",
    "build:computer-fixture:macos": "swift build -c release --package-path native/macos-computer-runtime --product chatgpt-system-computer-runtime-fixture",
    "test:computer:macos": "swift test --package-path native/macos-computer-runtime",
    "package:computer:macos": "npm run build:computer:macos && node scripts/package-macos-computer-runtime.mjs --sign -",
    "package:computer-fixture:macos": "npm run build:computer-fixture:macos && node scripts/package-macos-computer-runtime-fixture.mjs --sign -",
    "install:broker:macos": "node scripts/install-macos-authority-broker.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "setup:browser": "node scripts/setup-browser.mjs",
    "setup:codex": "npm run build && node scripts/setup-codex.mjs",
    "setup:chatgpt": "npm run build && node scripts/setup-chatgpt-tunnel.mjs",
    "doctor:chatgpt": "node scripts/setup-chatgpt-tunnel.mjs --doctor",
    "setup:daily-driver": "npm run build && node scripts/setup-daily-driver.mjs install",
    "daily-driver:status": "node scripts/setup-daily-driver.mjs status",
    "daily-driver:uninstall": "node scripts/setup-daily-driver.mjs uninstall",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "setup:computer:macos": "node scripts/setup-macos-computer-runtime.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "diff": "^8.0.2",
    "playwright": "1.63.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
