# Roots are separated with the OS path delimiter (: on macOS/Linux, ; on Windows).
CHATGPT_SYSTEM_ROOTS=/absolute/path/to/project

# HTTP mode requires a token of at least 16 characters.
CHATGPT_SYSTEM_HTTP_HOST=127.0.0.1
CHATGPT_SYSTEM_HTTP_PORT=4312
CHATGPT_SYSTEM_HTTP_TOKEN=replace-with-a-long-random-secret

# Terminal is intentionally disabled unless explicitly enabled.
CHATGPT_SYSTEM_ENABLE_TERMINAL=false
CHATGPT_SYSTEM_ALLOW_COMMANDS=git,node,npm,npx,pnpm,bun,deno,python3,go,cargo,swift,swiftc,xcodebuild,make,cmake

# Browser automation is disabled unless explicitly enabled and uses a dedicated profile.
CHATGPT_SYSTEM_ENABLE_BROWSER=false
CHATGPT_SYSTEM_BROWSER_HEADLESS=false
CHATGPT_SYSTEM_BROWSER_TIMEOUT_MS=10000
CHATGPT_SYSTEM_BROWSER_USER_DATA_DIR=~/.chatgpt-system/browser-profile

# Optional limits.
CHATGPT_SYSTEM_MAX_READ_BYTES=1048576
CHATGPT_SYSTEM_MAX_WRITE_BYTES=2097152
CHATGPT_SYSTEM_MAX_DIRECTORY_ENTRIES=2000
CHATGPT_SYSTEM_MAX_COMMAND_OUTPUT_BYTES=1048576
CHATGPT_SYSTEM_COMMAND_TIMEOUT_MS=60000
CHATGPT_SYSTEM_MAX_MANAGED_PROCESSES=32
CHATGPT_SYSTEM_MAX_PROCESS_LOG_BYTES_PER_STREAM=131072
CHATGPT_SYSTEM_PROCESS_STOP_GRACE_MS=3000
